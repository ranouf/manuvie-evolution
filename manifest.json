{
  "manifest_version": 3,
  "name": "Manuvie Évolution",
  "version": "0.2.20",
  "description": "Affiche les gains, rendements et frais directement dans le portail Gestion de patrimoine Manuvie.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://manulifewealth.myinvestorportal.ca/*",
    "https://api.myinvestorportal.ca/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://manulifewealth.myinvestorportal.ca/*"],
      "js": ["src/network-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://manulifewealth.myinvestorportal.ca/*"],
      "js": ["src/analytics.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_start"
    }
  ]
}
