{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["chrome", "jest", "node"]
  },
  "include": ["src/**/*.js", "tests/**/*.js", "scripts/**/*.mjs"]
}
